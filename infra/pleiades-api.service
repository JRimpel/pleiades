[Unit]
Description=Pleiades Flask API (gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pleiades
Group=pleiades
WorkingDirectory=/opt/pleiades/backend
EnvironmentFile=/opt/pleiades/.env
ExecStart=/opt/pleiades/backend/.venv/bin/gunicorn --worker-class gthread --workers 2 --threads 8 --bind 127.0.0.1:8000 --access-logfile - --timeout 60 'app:create_app()'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
