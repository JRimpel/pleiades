# --- Database (Tiger Cloud in prod; local docker-compose in dev) ---
DATABASE_URL=postgres://postgres:password@localhost:5432/pleiades
# DATABASE_URL=postgres://tsdbadmin:...@xxxx.tsdb.cloud.timescale.com:5432/tsdb?sslmode=require
DB_POOL_MIN=1
DB_POOL_MAX=10

# --- Gemini (owned by AI/ML; backend only passes these through) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Vultr Object Storage ---
# Local dev: `docker compose up -d storage`, then use endpoint http://localhost:8333, region us-east-1,
# access key pleiades-dev, secret pleiades-dev-secret (see README "Photo storage").
VULTR_S3_ENDPOINT=https://ewr1.vultrobjects.com
VULTR_S3_REGION=ewr1
VULTR_S3_ACCESS_KEY=
VULTR_S3_SECRET_KEY=
VULTR_S3_BUCKET=pleiades-photos
# If set, photo/thumbnail URLs are built as <PUBLIC_BASE>/<key> (public-read bucket); otherwise presigned GETs are used.
VULTR_S3_PUBLIC_BASE=

PUBLIC_APP_ORIGIN=http://localhost:5173

# --- Region / grid ---
REGION_TZ=America/New_York
GRID_STEP_DEG=0.1
REGION_CENTROID_LAT=42.7
REGION_CENTROID_LON=-78.4
FORECAST_HOURS=72
# Optional: grid source for `python -m app.ingest grid` (default: <repo>/data/wny_grid.geojson)
# GRID_GEOJSON_PATH=

# --- Limits ---
MAX_UPLOAD_BYTES=15728640
UPLOADS_PER_HOUR=20
PHOTO_WORKERS=4
EXPLAIN_TIMEOUT_S=12
# Pause between Gemini calls when pre-warming explanations (free tier allows 5/min; 0 on a paid tier)
EXPLAIN_WARM_INTERVAL_S=30
# "Ask the sky" chat: questions per client IP per minute, and the time budget for one answer (seconds)
CHAT_PER_MINUTE=10
CHAT_BUDGET_S=40
